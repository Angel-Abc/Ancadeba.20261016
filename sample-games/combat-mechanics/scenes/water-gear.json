{
  "schema-version": "1.0.0",
  "id": "water-gear",
  "title": "Diving gear: Battle in the flooded grotto",
  "type": "game",
  "screen": {
    "type": "grid",
    "grid": {
      "rows": 12,
      "columns": 12
    }
  },
  "components": [
    {
      "id": "combat",
      "type": "combat",
      "encounter": "water",
      "placement": {
        "row": 1,
        "column": 1,
        "rowSpan": 8,
        "columnSpan": 9
      }
    },
    {
      "id": "instructions",
      "type": "text",
      "text": "Equip the diving suit and rebreather in the gear room before entering. The suit adds 25% water resistance; the rebreather halves exhaustion gains (rounded down). A queues Purge valve: 1 AP and 5 stamina recover 20 exhaustion, available only while equipped. Inspect equipped mechanics and damage defenses in combat. Loadouts stay locked while a fight is unfinished. Water adds 5 exhaustion per turn with the rebreather, instead of 10. E queues Float and recover; B resolves.",
      "placement": {
        "row": 1,
        "column": 10,
        "rowSpan": 6,
        "columnSpan": 3
      }
    },
    {
      "id": "leave",
      "type": "button",
      "label": "Pause and return",
      "action": {
        "type": "enter-scene",
        "scene": "harbour"
      },
      "placement": {
        "row": 8,
        "column": 10,
        "columnSpan": 3
      }
    },
    {
