        "row": 1,
        "column": 1,
        "rowSpan": 2,
        "columnSpan": 12
      }
    },
    {
      "id": "water",
      "type": "button",
      "label": "Water battle",
      "action": {
        "type": "enter-scene",
        "scene": "water"
      },
      "placement": {
        "row": 3,
        "column": 1,
        "columnSpan": 5
      }
    },
    {
      "id": "boss",
