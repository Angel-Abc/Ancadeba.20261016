{
  "schema-version": "1.0.0",
  "id": "diving-gear",
  "title": "Diving gear room",
  "type": "game",
  "screen": {
    "type": "grid",
    "grid": {
      "rows": 12,
      "columns": 12
    }
  },
  "components": [
    {
      "id": "gear-items",
      "type": "inventory",
      "label": "Diving gear — select an item to compare",
      "owners": ["diver"],
      "readOnly": false,
      "placement": {
        "row": 1,
        "column": 1,
        "rowSpan": 9,
        "columnSpan": 6
      }
    },
    {
      "id": "item-details",
      "type": "item-details",
      "inventory": "gear-items",
      "label": "Selected gear",
      "equipment": "equipment",
      "showCombatStats": true,
      "placement": {
        "row": 1,
        "column": 7,
        "rowSpan": 6,
        "columnSpan": 6
      }
    },
    {
      "id": "equipment",
      "type": "equipment",
      "inventory": "gear-items",
      "owner": "diver",
      "label": "Equipped diving gear",
      "columns": 3,
      "order": ["body", "back", "charm"],
      "showCombatStats": true,
      "placement": {
        "row": 7,
        "column": 7,
        "rowSpan": 3,
        "columnSpan": 6
      }
    },
    {
      "id": "commands",
      "type": "action-bar",
      "placement": {
        "row": 10,
        "column": 1,
        "rowSpan": 2,
        "columnSpan": 12
      },
      "slots": {
        "1": {
          "label": "Equip",
          "action": {
            "type": "equipment-action",
            "equipment": "equipment",
            "operation": "equip"
          }
        },
        "2": {
          "label": "Unequip",
          "action": {
            "type": "equipment-action",
            "equipment": "equipment",
            "operation": "unequip"
          }
        },
        "3": {
          "label": "Water with diving gear",
          "action": {
            "type": "enter-scene",
            "scene": "water-gear"
          }
        },
        "4": {
          "label": "Underwater guardian with gear",
          "action": {
            "type": "enter-scene",
            "scene": "underwater-boss-gear"
          }
        },
        "5": {
          "label": "Back to harbour",
          "action": {
            "type": "enter-scene",
            "scene": "harbour"
          }
        },
        "6": {
          "label": "Water passives",
          "action": {
            "type": "enter-scene",
            "scene": "water-passives"
          }
        },
        "7": {
          "label": "Underwater boss passives",
          "action": {
            "type": "enter-scene",
            "scene": "underwater-boss-passives"
          }
        },
        "8": {
          "label": "Water interception",
          "action": {
            "type": "enter-scene",
            "scene": "water-interception"
          }
        },
        "9": {
          "label": "Underwater boss interception",
          "action": {
            "type": "enter-scene",
            "scene": "underwater-boss-interception"
          }
        }
      }
    },
    {
      "id": "gear-help",
      "type": "text",
      "text": "Gear starts carried. Select each item and click Equip before entering a battle. Carried items give no combat benefits. An unfinished battle locks the loadout; escape or finish before changing gear. New game resets every encounter and returns both items to inventory.",
      "placement": {
        "row": 12,
        "column": 1,
        "columnSpan": 12
      }
    }
  ]
}
