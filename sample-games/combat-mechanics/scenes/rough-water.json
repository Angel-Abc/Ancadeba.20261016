{
  "schema-version": "1.0.0",
  "id": "rough-water",
  "title": "Deep water: local overrides",
  "type": "game",
  "screen": {
    "type": "grid",
    "grid": {
      "rows": 12,
      "columns": 12
    }
  },
  "components": [
    {
      "id": "combat",
      "type": "combat",
      "encounter": "rough-water",
      "placement": {
        "row": 1,
        "column": 1,
        "rowSpan": 8,
        "columnSpan": 9
      }
    },
    {
      "id": "instructions",
      "type": "text",
      "text": "Pressure adds 20 exhaustion. Local Exhausted raises every action cost by 1 AP at 60 exhaustion and 2 at 90, instead of reducing the AP budget. E recovers; recovery always fits the 3 AP budget. A stacks rhythm, B resolves.",
      "placement": {
        "row": 1,
        "column": 10,
        "rowSpan": 6,
        "columnSpan": 3
      }
    },
    {
      "id": "leave",
      "type": "button",
      "label": "Pause and return",
      "action": {
        "type": "enter-scene",
        "scene": "harbour"
      },
      "placement": {
        "row": 8,
        "column": 10,
        "columnSpan": 3
      }
    },
    {
      "id": "commands",
      "type": "action-bar",
      "placement": {
        "row": 10,
        "column": 1,
        "rowSpan": 3,
        "columnSpan": 12
      },
      "slots": {
        "1": {
          "label": "Quick thrust",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "queue-move",
              "move": "jab"
            }
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-1"
          }
        },
        "2": {
          "label": "Power stroke",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "queue-move",
              "move": "heavy"
            }
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-2"
          }
        },
        "4": {
          "label": "Undo",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "undo"
            }
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-4"
          }
        },
        "5": {
          "label": "Clear",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "clear"
            }
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-5"
          }
        },
        "8": {
          "label": "Escape",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "escape"
            }
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-8"
          }
        },
        "14": {
          "label": "Continue",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "continue"
            }
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-14"
          }
        },
        "15": {
          "label": "End turn",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "end-turn"
            }
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-15"
          }
        },
        "3": {
          "label": "Float and recover",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "queue-move",
              "move": "rest"
            }
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-3"
          }
        },
        "6": {
          "label": "Find swimming rhythm",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "queue-move",
              "move": "steady-breath"
            }
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-6"
          }
        }
      }
    }
  ]
}
