      "modifiers": {
        "defense": 2
      }
    },
    "focused": {
      "type": "modifier",
      "label": "Last resolve",
      "description": "At 25% health, channeling in the first two phases gains 5 extra seal energy after the action.",
      "duration": 1,
      "modifiers": {
        "defense": 1
      }
    },
    "flow": {
      "type": "modifier",
      "label": "Current focus",
      "description": "Per intensity: +25% damage, +20% healing, and -25% AP cost, applied after flat modifiers. Lightning damage also heals its source for half the actual damage (then healing bonuses); that actual healing relieves the same amount of exhaustion.",
