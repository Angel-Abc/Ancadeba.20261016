      "damageDefenses": {
        "resistances": {
          "lightning": 25
        },
        "immunities": ["fire"]
      },
      "intensity": {
        "initial": 1,
        "maximum": 2,
        "reapply": "replace"
      },
      "statusImmunities": ["silenced"]
    },
    "silenced": {
      "type": "composite",
      "label": "Silenced",
      "description": "Blocks moves categorized as spell. Utility recovery remains available.",
      "duration": 2,
      "blockedMoveCategories": ["spell"]
    },
    "disarmed": {
      "type": "composite",
      "label": "Disarmed",
      "description": "Blocks moves categorized as weapon. Spell and utility actions remain available.",
      "duration": 2,
      "blockedMoveCategories": ["weapon"]
    },
    "dazed": {
      "type": "stun",
      "label": "Dazed",
      "description": "Skips one affected turn unless the recipient is immune to this status ID.",
      "duration": 1
    },
    "unshaken": {
      "type": "composite",
      "label": "Clear mind",
