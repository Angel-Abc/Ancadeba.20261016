      "modifiers": {},
      "percentModifiers": {
        "damage": 25,
        "healing": 20,
        "apCost": -25
      },
      "intensity": {
        "initial": 1,
        "maximum": 2,
        "reapply": "replace"
      }
    },
    "venom": {
      "type": "damage",
      "label": "Venom",
      "description": "Poison damage each turn; poison immunity prevents the damage, while the status still lasts normally.",
      "duration": 2,
      "amount": 4,
      "damageType": "poison"
    },
    "tidal-shell": {
      "type": "composite",
      "label": "Tidal shell",
      "description": "Per intensity: 25% lightning resistance. Also grants fire immunity. At intensity 2 it cancels the guardian's 50% lightning vulnerability. Also prevents new Silence applications while active.",
