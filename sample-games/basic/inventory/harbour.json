          "action": "inspect-chart"
        }
      },
      "labelKey": "items.harbour-chart.name",
      "descriptionKey": "items.harbour-chart.description",
      "properties": [
        {
          "id": "category",
          "labelKey": "items.category",
          "value": "Document",
          "valueKey": "items.document"
        }
      ]
    }
  },
  "owners": {
    "display-case": {
      "label": "Display case",
      "labelKey": "inventory.owner.displayCase"
    }
  },
  "items": {
    "harbour-chart": {
      "itemType": "harbour-chart",
      "placement": {
        "type": "carried",
