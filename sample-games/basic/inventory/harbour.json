{
  "schema-version": "1.0.0",
  "itemTypes": {
    "harbour-chart": {
      "label": "Harbour chart",
      "inspection": {
        "action": "inspect-chart",
        "details": {
          "source": "game.state",
          "path": ["chartDetails"]
        },
        "inline": false
      },
      "actions": {
