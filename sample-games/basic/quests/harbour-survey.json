{
  "schema-version": "1.0.0",
  "id": "harbour-survey",
  "labelKey": "quest.survey.name",
  "descriptionKey": "quest.survey.description",
  "stages": [
    {
      "id": "explore",
      "labelKey": "quest.survey.explore",
      "objectives": [
        {
          "id": "harbour",
          "labelKey": "quest.survey.visit",
          "when": [
            {
              "type": "scene-is",
              "scene": "old-harbour"
            }
          ]
        }
      ]
    },
    {
      "id": "report",
      "labelKey": "quest.survey.report",
      "objectives": [
        {
          "id": "return",
          "labelKey": "quest.survey.return",
          "when": [
            {
              "type": "scene-is",
              "scene": "standard"
            }
          ]
        }
      ]
    }
  ],
  "outcomes": [
    {
      "id": "published",
      "labelKey": "quest.survey.published",
      "descriptionKey": "quest.survey.publishedDesc",
      "rewards": {
        "numeric": [
          {
            "id": "xp",
            "labelKey": "quest.survey.xp",
            "field": {
              "source": "game.state",
              "path": ["player", "experience"]
            },
            "amount": 5
          }
        ]
      }
    },
    {
      "id": "sold",
      "labelKey": "quest.survey.sold",
      "descriptionKey": "quest.survey.soldDesc",
      "rewards": {
        "numeric": [
          {
            "id": "gold",
            "labelKey": "quest.survey.gold",
            "field": {
              "source": "game.state",
              "path": ["player", "gold"]
            },
            "amount": 8
          }
        ]
      }
    }
  ]
}
