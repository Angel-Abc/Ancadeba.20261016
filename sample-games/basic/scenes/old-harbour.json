{
  "schema-version": "1.0.0",
  "id": "old-harbour",
  "type": "game",
  "titleKey": "scenes.old-harbour.title",
  "descriptionKey": "scenes.old-harbour.description",
  "screen": {
    "type": "grid",
    "grid": {
      "rows": 12,
      "columns": 12
    }
  },
  "components": [
    {
      "id": "location-title",
      "type": "text",
      "placement": {
        "row": 1,
        "column": 3,
        "rowSpan": 2,
        "columnSpan": 8
      },
      "textKey": "scenes.old-harbour.title",
      "presentation": {
        "variant": "heading",
        "align": "center"
      }
    },
    {
      "id": "narrative",
      "type": "text",
      "placement": {
        "row": 3,
        "column": 3,
        "rowSpan": 6,
        "columnSpan": 8
      },
      "textKey": "scenes.old-harbour.narrative",
      "bindings": {
        "inspection": {
          "source": "game.state",
          "path": ["inspectionResult"],
          "fallback": ""
        }
      }
    },
    {
      "id": "nearby",
      "type": "nearby",
      "labelKey": "nearby.title",
      "placement": {
        "row": 3,
        "column": 11,
        "rowSpan": 2,
        "columnSpan": 2
      },
      "descriptionTarget": "narrative",
      "entries": {
        "boat": {
          "kind": "object",
          "labelKey": "nearby.boat.name",
          "descriptionKey": "nearby.boat.description",
          "actions": {
            "examine": {
              "action": "examine-boat"
            }
          }
        }
      }
    },
    {
      "id": "player-status",
      "type": "status-panel",
      "labelKey": "status.title",
      "nameKey": "status.player",
      "placement": {
        "row": 3,
        "column": 1,
        "rowSpan": 3,
        "columnSpan": 2
      },
      "rows": [
        {
          "id": "level",
          "type": "value",
          "labelKey": "status.level",
          "value": {
            "source": "game.state",
            "path": ["player", "level"]
          }
        },
        {
          "id": "health",
          "type": "bar",
          "labelKey": "status.health",
          "value": {
            "source": "game.state",
            "path": ["player", "health"]
          },
          "maximum": {
            "source": "game.state",
            "path": ["player", "maximumHealth"]
          },
          "color": "#e64b6a"
        },
        {
          "id": "gold",
          "type": "value",
          "labelKey": "status.gold",
          "value": {
            "source": "game.state",
            "path": ["player", "gold"]
          }
        }
      ],
      "effects": [
        {
          "id": "informed",
          "labelKey": "status.informed",
          "descriptionKey": "status.informed.description",
          "visibleWhen": {
            "source": "game.state",
            "path": ["letterRead"]
          }
        }
      ]
    },
    {
      "id": "items",
      "type": "inventory",
      "placement": {
        "row": 5,
        "column": 11,
        "rowSpan": 4,
        "columnSpan": 2
      },
      "owners": ["player"],
      "readOnly": true,
      "labelKey": "scenes.inventory.title",
      "descriptionTarget": "narrative"
    },
    {
      "id": "map-key",
      "type": "text",
      "placement": {
        "row": 6,
        "column": 1,
        "rowSpan": 2,
        "columnSpan": 2
      },
      "textKey": "harbour.map-key"
    },
    {
      "id": "harbour-map",
      "type": "map-view",
      "labelKey": "scenes.old-harbour.map",
      "placement": {
        "row": 8,
        "column": 1,
        "rowSpan": 2,
        "columnSpan": 2
      },
      "map": "harbour",
      "viewport": {
        "columns": 7,
        "rows": 5
      },
      "playerSpawn": {
        "x": 1,
        "y": 3
      },
      "interactive": false
    },
    {
      "id": "event-log",
      "type": "text",
      "placement": {
        "row": 9,
        "column": 11,
        "rowSpan": 4,
        "columnSpan": 2
      },
      "textKey": "museum.event-log",
      "bindings": {
        "log": {
          "source": "game.state",
          "path": ["log"],
          "fallback": ""
        }
      }
    },
    {
      "id": "clock",
      "type": "text",
      "placement": {
        "row": 10,
        "column": 1,
        "rowSpan": 2,
        "columnSpan": 2
      },
      "textKey": "harbour.clock",
      "bindings": {
        "time": {
          "source": "game.state",
          "path": ["clock"],
          "fallback": "09:00"
        }
      }
    },
    {
      "id": "action-bar",
      "type": "action-bar",
      "placement": {
        "row": 10,
        "column": 3,
        "rowSpan": 3,
        "columnSpan": 8
      },
      "slots": {
        "1": {
          "labelKey": "harbour.walk-to-museum",
          "action": {
            "type": "request-action",
            "action": "walk-to-museum"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-1"
          }
        },
        "2": {
          "labelKey": "harbour.follow-chart-to-buoy",
          "action": {
            "type": "request-action",
            "action": "follow-chart-to-buoy",
            "enabledWhen": {
              "source": "game.state",
              "path": ["chartRead"]
            }
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-2"
          }
        },
        "4": {
          "labelKey": "actions.inspect",
          "action": {
            "type": "inventory-action",
            "inventory": "items",
            "action": "inspect"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-4"
          }
        },
        "5": {
          "labelKey": "actions.read",
          "action": {
            "type": "inventory-action",
            "inventory": "items",
            "action": "read"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-5"
          }
        },
        "6": {
          "labelKey": "actions.talk",
          "action": {
            "type": "nearby-action",
            "nearby": "nearby",
            "action": "talk"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-6"
          }
        },
        "7": {
          "labelKey": "actions.examine",
          "action": {
            "type": "nearby-action",
            "nearby": "nearby",
            "action": "examine"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-7"
          }
        },
        "8": {
          "labelKey": "actions.take",
          "action": {
            "type": "nearby-action",
            "nearby": "nearby",
            "action": "take"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-8"
          }
        }
      }
    }
  ]
}
