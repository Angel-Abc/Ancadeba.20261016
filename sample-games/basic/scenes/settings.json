{
  "schema-version": "1.0.0",
  "id": "settings",
  "title": "Settings",
  "description": "An independent scene",
  "type": "stand-alone",
  "screen": { "type": "grid", "grid": { "rows": 12, "columns": 12 } },
  "components": [
    {
      "id": "title",
      "type": "text",
      "placement": { "row": 1, "column": 1, "rowSpan": 2, "columnSpan": 12 },
      "text": "Settings",
      "presentation": { "variant": "heading", "align": "center" }
    },
    {
      "id": "reading-preferences",
      "type": "text",
      "placement": { "row": 3, "column": 3, "rowSpan": 8, "columnSpan": 8 },
      "text": "Reading preferences\n\nA place for comfortable text, clear contrast, and room to read.\n\nThis layout example uses static text. Interactive settings will follow later."
    }
  ]
}
