{
  "schema-version": "1.0.0",
  "id": "settings",
  "type": "stand-alone",
  "screen": {
    "type": "grid",
    "grid": {
      "rows": 12,
      "columns": 12
    }
  },
  "components": [
    {
      "id": "title",
      "type": "text",
      "placement": {
        "row": 1,
        "column": 1,
        "rowSpan": 2,
        "columnSpan": 12
      },
      "presentation": {
        "variant": "heading",
        "align": "center"
      },
      "textKey": "scenes.settings.components.title.text"
    },
    {
      "id": "language",
      "type": "language-select",
      "placement": {
        "row": 4,
        "column": 4,
        "rowSpan": 2,
        "columnSpan": 6
      },
      "labelKey": "scenes.settings.components.language.label"
    },
    {
      "id": "language-help",
      "type": "text",
      "placement": {
        "row": 7,
        "column": 3,
        "rowSpan": 3,
        "columnSpan": 8
      },
      "textKey": "scenes.settings.components.language-help.text"
    },
    {
      "id": "back",
      "type": "button",
      "placement": {
        "row": 11,
        "column": 5,
        "columnSpan": 4
      },
      "action": {
        "type": "enter-scene",
        "scene": "start-screen"
      },
      "labelKey": "scenes.settings.components.back.label"
    }
  ],
  "titleKey": "scenes.settings.title",
  "descriptionKey": "scenes.settings.description"
}
