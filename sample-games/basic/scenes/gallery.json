{
  "schema-version": "1.0.0",
  "id": "gallery",
  "type": "game",
  "titleKey": "scenes.gallery.title",
  "descriptionKey": "scenes.gallery.description",
  "screen": {
    "type": "grid",
    "grid": {
      "rows": 12,
      "columns": 12
    }
  },
  "components": [
    {
      "id": "location-title",
      "type": "text",
      "placement": {
        "row": 1,
        "column": 3,
        "rowSpan": 2,
        "columnSpan": 8
      },
      "presentation": {
        "variant": "heading",
        "align": "center"
      },
      "textKey": "scenes.gallery.title"
    },
    {
      "id": "player-status",
      "type": "status-panel",
      "labelKey": "status.title",
      "nameKey": "status.player",
      "placement": {
        "row": 3,
        "column": 1,
        "rowSpan": 3,
        "columnSpan": 2
      },
      "rows": [
        {
          "id": "level",
          "type": "value",
          "labelKey": "status.level",
          "value": {
            "source": "game.state",
            "path": ["player", "level"]
          }
        },
        {
          "id": "health",
          "type": "bar",
          "labelKey": "status.health",
          "value": {
            "source": "game.state",
            "path": ["player", "health"]
          },
          "maximum": {
            "source": "game.state",
            "path": ["player", "maximumHealth"]
          },
          "color": "#e64b6a"
        },
        {
          "id": "gold",
          "type": "value",
          "labelKey": "status.gold",
          "value": {
            "source": "game.state",
            "path": ["player", "gold"]
          }
        }
      ],
      "effects": [
        {
          "id": "informed",
          "labelKey": "status.informed",
          "descriptionKey": "status.informed.description",
          "visibleWhen": {
            "source": "game.state",
            "path": ["letterRead"]
          }
        }
      ]
    },
    {
      "id": "narrative",
      "type": "text",
      "placement": {
        "row": 3,
        "column": 3,
        "rowSpan": 6,
        "columnSpan": 8
      },
      "textKey": "scenes.gallery.components.narrative.text",
      "bindings": {
        "case": {
          "source": "game.state",
          "path": ["caseDescription"],
          "fallback": "A locked display case bears a brass crest with two raised symbols."
        },
        "inspection": {
          "source": "game.state",
          "path": ["inspectionResult"],
          "fallback": ""
        }
      }
    },
    {
      "id": "nearby",
      "type": "text",
      "placement": {
        "row": 3,
        "column": 11,
        "rowSpan": 2,
        "columnSpan": 2
      },
      "textKey": "scenes.gallery.components.nearby.text",
      "bindings": {
        "case": {
          "source": "game.state",
          "path": ["caseLabel"],
          "fallback": "Locked display case"
        }
      }
    },
    {
      "id": "footer",
      "type": "text",
      "placement": {
        "row": 9,
        "column": 3,
        "rowSpan": 1,
        "columnSpan": 8
      },
      "bindings": {
        "turn": {
          "source": "game.progression",
          "path": ["turn"]
        },
        "worldTimeMs": {
          "source": "game.progression",
          "path": ["worldTimeMs"]
        }
      },
      "presentation": {
        "align": "center"
      },
      "textKey": "scenes.gallery.components.footer.text"
    },
    {
      "id": "map-key",
      "type": "text",
      "placement": {
        "row": 6,
        "column": 1,
        "rowSpan": 2,
        "columnSpan": 2
      },
      "textKey": "museum.map-key"
    },
    {
      "id": "museum-map",
      "type": "map-view",
      "labelKey": "museum.map-gallery",
      "placement": {
        "row": 8,
        "column": 1,
        "rowSpan": 2,
        "columnSpan": 2
      },
      "map": "museum",
      "viewport": {
        "columns": 7,
        "rows": 3
      },
      "playerSpawn": {
        "x": 5,
        "y": 1
      },
      "interactive": false
    },
    {
      "id": "clock",
      "type": "text",
      "placement": {
        "row": 10,
        "column": 1,
        "rowSpan": 2,
        "columnSpan": 2
      },
      "textKey": "museum.clock",
      "bindings": {
        "time": {
          "source": "game.state",
          "path": ["clock"],
          "fallback": "09:00"
        }
      }
    },
    {
      "id": "items",
      "type": "inventory",
      "placement": {
        "row": 5,
        "column": 11,
        "rowSpan": 4,
        "columnSpan": 2
      },
      "owners": ["player"],
      "readOnly": true,
      "labelKey": "scenes.inventory.title",
      "descriptionTarget": "narrative"
    },
    {
      "id": "event-log",
      "type": "text",
      "placement": {
        "row": 9,
        "column": 11,
        "rowSpan": 4,
        "columnSpan": 2
      },
      "textKey": "museum.event-log",
      "bindings": {
        "log": {
          "source": "game.state",
          "path": ["log"],
          "fallback": ""
        }
      }
    },
    {
      "id": "action-bar",
      "type": "action-bar",
      "placement": {
        "row": 10,
        "column": 3,
        "rowSpan": 3,
        "columnSpan": 8
      },
      "slots": {
        "1": {
          "labelKey": "museum.walk-west",
          "action": {
            "type": "request-action",
            "action": "walk-west"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-1"
          }
        },
        "2": {
          "labelKey": "museum.press-crown",
          "action": {
            "type": "request-action",
            "action": "press-crown",
            "enabledWhen": {
              "source": "game.state",
              "path": ["canOpenCase"]
            }
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-2"
          }
        },
        "3": {
          "labelKey": "museum.press-heron",
          "action": {
            "type": "request-action",
            "action": "press-heron",
            "enabledWhen": {
              "source": "game.state",
              "path": ["canOpenCase"]
            }
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-3"
          }
        },
        "4": {
          "labelKey": "actions.inspect",
          "action": {
            "type": "inventory-action",
            "inventory": "items",
            "action": "inspect"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-4"
          }
        },
        "5": {
          "labelKey": "actions.read",
          "action": {
            "type": "inventory-action",
            "inventory": "items",
            "action": "read"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-5"
          }
        },
        "6": {
          "labelKey": "museum.take-chart",
          "action": {
            "type": "request-action",
            "action": "take-chart",
            "enabledWhen": {
              "source": "game.state",
              "path": ["canTakeChart"]
            }
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-6"
          }
        }
      }
    }
  ]
}
