{
  "schema-version": "1.0.0",
  "id": "standard",
  "type": "game",
  "screen": {
    "type": "grid",
    "grid": {
      "rows": 12,
      "columns": 12
    }
  },
  "components": [
    {
      "id": "location-title",
      "type": "text",
      "placement": {
        "row": 1,
        "column": 3,
        "rowSpan": 2,
        "columnSpan": 8
      },
      "presentation": {
        "variant": "heading",
        "align": "center"
      },
      "textKey": "scenes.standard.components.location-title.text"
    },
    {
      "id": "player-status",
      "type": "text",
      "placement": {
        "row": 3,
        "column": 1,
        "rowSpan": 8,
        "columnSpan": 2
      },
      "bindings": {
        "health": {
          "source": "game.state",
          "path": ["player", "health"],
          "fallback": "40"
        }
      },
      "textKey": "scenes.standard.components.player-status.text"
    },
    {
      "id": "narrative",
      "type": "text",
      "placement": {
        "row": 3,
        "column": 3,
        "rowSpan": 8,
        "columnSpan": 8
      },
      "textKey": "scenes.standard.components.narrative.text"
    },
    {
      "id": "nearby",
      "type": "text",
      "placement": {
        "row": 3,
        "column": 11,
        "rowSpan": 8,
        "columnSpan": 2
      },
      "textKey": "scenes.standard.components.nearby.text"
    },
    {
      "id": "footer",
      "type": "text",
      "placement": {
        "row": 11,
        "column": 1,
        "rowSpan": 2,
        "columnSpan": 12
      },
      "bindings": {
        "turn": {
          "source": "game.progression",
          "path": ["turn"]
        },
        "worldTimeMs": {
          "source": "game.progression",
          "path": ["worldTimeMs"]
        }
      },
      "presentation": {
        "align": "center"
      },
      "textKey": "scenes.standard.components.footer.text"
    }
  ],
  "titleKey": "scenes.standard.title",
  "descriptionKey": "scenes.standard.description"
}
