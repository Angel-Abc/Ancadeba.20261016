{
  "schema-version": "1.0.0",
  "id": "standard",
  "type": "game",
  "screen": {
    "type": "grid",
    "grid": {
      "rows": 12,
      "columns": 12
    }
  },
  "components": [
    {
      "id": "location-title",
      "type": "text",
      "placement": {
        "row": 1,
        "column": 3,
        "rowSpan": 2,
        "columnSpan": 8
      },
      "presentation": {
        "variant": "heading",
        "align": "center"
      },
      "textKey": "scenes.standard.components.location-title.text"
    },
    {
      "id": "player-status",
      "type": "status-panel",
      "labelKey": "status.title",
      "nameKey": "status.player",
      "placement": {
        "row": 3,
        "column": 1,
        "rowSpan": 3,
        "columnSpan": 2
      },
      "rows": [
        {
          "id": "level",
          "type": "value",
          "labelKey": "status.level",
          "value": {
            "source": "game.state",
            "path": ["player", "level"]
          }
        },
        {
          "id": "health",
          "type": "bar",
          "labelKey": "status.health",
          "value": {
            "source": "game.state",
            "path": ["player", "health"]
          },
          "maximum": {
            "source": "game.state",
            "path": ["player", "maximumHealth"]
          },
          "color": "#e64b6a"
        },
        {
          "id": "gold",
          "type": "value",
          "labelKey": "status.gold",
          "value": {
            "source": "game.state",
            "path": ["player", "gold"]
          }
        }
      ],
      "effects": [
        {
          "id": "informed",
          "labelKey": "status.informed",
          "descriptionKey": "status.informed.description",
          "visibleWhen": {
            "source": "game.state",
            "path": ["letterRead"]
          }
        }
      ]
    },
    {
      "id": "narrative",
      "type": "text",
      "placement": {
        "row": 3,
        "column": 3,
        "rowSpan": 6,
        "columnSpan": 8
      },
      "textKey": "scenes.standard.components.narrative.text",
      "bindings": {
        "inspection": {
          "source": "game.state",
          "path": ["inspectionResult"],
          "fallback": ""
        }
      }
    },
    {
      "id": "nearby",
      "type": "nearby",
      "labelKey": "nearby.title",
      "placement": {
        "row": 3,
        "column": 11,
        "rowSpan": 2,
        "columnSpan": 2
      },
      "descriptionTarget": "narrative",
      "entries": {
        "curator": {
          "kind": "character",
          "labelKey": "nearby.curator.name",
          "descriptionKey": "nearby.curator.description",
          "actions": {
            "talk": {
              "action": "talk-curator"
            }
          },
          "dialogue": "curator"
        },
        "folded-letter": {
          "kind": "object",
          "labelKey": "nearby.letter.name",
          "descriptionKey": "nearby.letter.description",
          "visibleWhen": {
            "source": "game.state",
            "path": ["canTakeLetter"]
          },
          "actions": {
            "take": {
              "action": "take-letter"
            }
          }
        },
        "kiosk": {
          "kind": "object",
          "labelKey": "shop.kiosk",
          "descriptionKey": "shop.kiosk.description",
          "actions": {
            "visit": {
              "action": "visit-shop"
            }
          }
        }
      }
    },
    {
      "id": "footer",
      "type": "text",
      "placement": {
        "row": 9,
        "column": 3,
        "rowSpan": 1,
        "columnSpan": 8
      },
      "bindings": {
        "turn": {
          "source": "game.progression",
          "path": ["turn"]
        },
        "worldTimeMs": {
          "source": "game.progression",
          "path": ["worldTimeMs"]
        }
      },
      "presentation": {
        "align": "center"
      },
      "textKey": "scenes.standard.components.footer.text"
    },
    {
      "id": "map-key",
      "type": "text",
      "placement": {
        "row": 6,
        "column": 1,
        "rowSpan": 2,
        "columnSpan": 2
      },
      "textKey": "museum.map-key"
    },
    {
      "id": "museum-map",
      "type": "map-view",
      "labelKey": "museum.map-lobby",
      "placement": {
        "row": 8,
        "column": 1,
        "rowSpan": 2,
        "columnSpan": 2
      },
      "map": "museum",
      "viewport": {
        "columns": 7,
        "rows": 3
      },
      "playerSpawn": {
        "x": 1,
        "y": 1
      },
      "interactive": false
    },
    {
      "id": "clock",
      "type": "text",
      "placement": {
        "row": 10,
        "column": 1,
        "rowSpan": 2,
        "columnSpan": 2
      },
      "textKey": "museum.clock",
      "bindings": {
        "time": {
          "source": "game.state",
          "path": ["clock"],
          "fallback": "09:00"
        }
      }
    },
    {
      "id": "items",
      "type": "inventory",
      "placement": {
        "row": 5,
        "column": 11,
        "rowSpan": 2,
        "columnSpan": 2
      },
      "owners": ["player"],
      "readOnly": true,
      "labelKey": "scenes.inventory.title",
      "descriptionTarget": "narrative"
    },
    {
      "id": "event-log",
      "type": "text",
      "placement": {
        "row": 9,
        "column": 11,
        "rowSpan": 4,
        "columnSpan": 2
      },
      "textKey": "museum.event-log",
      "bindings": {
        "log": {
          "source": "game.state",
          "path": ["log"],
          "fallback": ""
        }
      }
    },
    {
      "id": "action-bar",
      "type": "action-bar",
      "placement": {
        "row": 10,
        "column": 3,
        "rowSpan": 3,
        "columnSpan": 8
      },
      "slots": {
        "1": {
          "labelKey": "harbour.walk-to-harbour",
          "action": {
            "type": "request-action",
            "action": "walk-to-harbour"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-1"
          }
        },
        "2": {
          "labelKey": "museum.take-letter",
          "action": {
            "type": "request-action",
            "action": "take-letter",
            "enabledWhen": {
              "source": "game.state",
              "path": ["canTakeLetter"]
            }
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-2"
          }
        },
        "3": {
          "labelKey": "museum.walk-east",
          "action": {
            "type": "request-action",
            "action": "walk-east"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-3"
          }
        },
        "4": {
          "labelKey": "actions.inspect",
          "action": {
            "type": "inventory-action",
            "inventory": "items",
            "action": "inspect"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-4"
          }
        },
        "5": {
          "labelKey": "actions.read",
          "action": {
            "type": "inventory-action",
            "inventory": "items",
            "action": "read"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-5"
          }
        },
        "6": {
          "labelKey": "actions.talk",
          "action": {
            "type": "nearby-action",
            "nearby": "nearby",
            "action": "talk"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-6"
          }
        },
        "7": {
          "labelKey": "actions.examine",
          "action": {
            "type": "nearby-action",
            "nearby": "nearby",
            "action": "examine"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-7"
          }
        },
        "8": {
          "labelKey": "actions.take",
          "action": {
            "type": "nearby-action",
            "nearby": "nearby",
            "action": "take"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-8"
          }
        },
        "9": {
          "labelKey": "shop.visit",
          "action": {
            "type": "nearby-action",
            "nearby": "nearby",
            "action": "visit"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-9"
          }
        },
        "10": {
          "labelKey": "combat.visit",
          "action": {
            "type": "enter-scene",
            "scene": "training"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-10"
          }
        },
        "11": {
          "labelKey": "dialogue.talk",
          "action": {
            "type": "dialogue-action",
            "nearby": "nearby",
            "command": {
              "type": "start"
            }
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-11"
          }
        },
        "12": {
          "labelKey": "dialogue.reply1",
          "action": {
            "type": "dialogue-action",
            "nearby": "nearby",
            "command": {
              "type": "choose",
              "position": 1
            }
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-12"
          }
        },
        "13": {
          "labelKey": "dialogue.reply2",
          "action": {
            "type": "dialogue-action",
            "nearby": "nearby",
            "command": {
              "type": "choose",
              "position": 2
            }
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-13"
          }
        },
        "14": {
          "labelKey": "dialogue.end",
          "action": {
            "type": "dialogue-action",
            "nearby": "nearby",
            "command": {
              "type": "end"
            }
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-14"
          }
        },
        "15": {
          "labelKey": "quest.turnIn",
          "action": {
            "type": "quest-action",
            "quest": "harbour-survey",
            "operation": "turn-in"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-15"
          }
        }
      }
    },
    {
      "id": "quests",
      "type": "quest-log",
      "labelKey": "quest.journal",
      "placement": {
        "row": 7,
        "column": 11,
        "rowSpan": 2,
        "columnSpan": 2
      },
      "textTarget": "narrative"
    }
  ],
  "titleKey": "scenes.standard.title",
  "descriptionKey": "scenes.standard.description"
}
