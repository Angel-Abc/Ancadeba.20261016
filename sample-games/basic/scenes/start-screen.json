{
  "schema-version": "1.0.0",
  "id": "start-screen",
  "type": "stand-alone",
  "screen": {
    "type": "grid",
    "grid": {
      "rows": 12,
      "columns": 12
    }
  },
  "components": [
    {
      "id": "title",
      "type": "text",
      "placement": {
        "row": 2,
        "column": 3,
        "rowSpan": 2,
        "columnSpan": 8
      },
      "presentation": {
        "variant": "heading",
        "align": "center"
      },
      "textKey": "scenes.start-screen.components.title.text"
    },
    {
      "id": "new-game",
      "type": "button",
      "placement": {
        "row": 5,
        "column": 5,
        "columnSpan": 4
      },
      "action": {
        "type": "new-game",
        "scene": "standard"
      },
      "labelKey": "scenes.start-screen.components.new-game.label"
    },
    {
      "id": "load-game",
      "type": "button",
      "placement": {
        "row": 7,
        "column": 5,
        "columnSpan": 4
      },
      "labelKey": "scenes.start-screen.components.load-game.label"
    },
    {
      "id": "settings",
      "type": "button",
      "placement": {
        "row": 9,
        "column": 5,
        "columnSpan": 4
      },
      "action": {
        "type": "enter-scene",
        "scene": "settings"
      },
      "labelKey": "scenes.start-screen.components.settings.label"
    }
  ],
  "titleKey": "scenes.start-screen.title",
  "descriptionKey": "scenes.start-screen.description"
}
