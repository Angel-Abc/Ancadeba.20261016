{
  "schema-version": "1.0.0",
  "id": "training",
  "type": "game",
  "titleKey": "combat.title",
  "screen": {
    "type": "grid",
    "grid": {
      "rows": 12,
      "columns": 12
    }
  },
  "components": [
    {
      "id": "combat",
      "type": "combat",
      "encounter": "training",
      "textTarget": "narrative",
      "placement": {
        "row": 1,
        "column": 1,
        "rowSpan": 7,
        "columnSpan": 9
      },
      "lootInventory": "loot"
    },
    {
      "id": "narrative",
      "type": "text",
