{
  "schema-version": "1.0.0",
  "id": "inventory",
  "type": "game",
  "screen": {
    "type": "grid",
    "grid": {
      "rows": 12,
      "columns": 12
    }
  },
  "components": [
    {
      "id": "title",
      "type": "text",
      "placement": {
        "row": 1,
        "column": 1,
        "rowSpan": 2,
        "columnSpan": 12
      },
      "presentation": {
        "variant": "heading",
        "align": "center"
      },
      "textKey": "scenes.inventory.components.title.text"
    },
    {
      "id": "items",
      "type": "inventory",
      "placement": {
        "row": 3,
        "column": 1,
        "rowSpan": 8,
        "columnSpan": 4
      },
      "owners": ["player"],
      "readOnly": true,
      "labelKey": "scenes.inventory.title"
    },
    {
      "id": "details",
      "type": "text",
      "placement": {
        "row": 3,
        "column": 5,
        "rowSpan": 2,
        "columnSpan": 8
      },
      "textKey": "scenes.inventory.components.details.text",
      "bindings": {
        "inspection": {
          "source": "game.state",
          "path": ["inspectionResult"],
          "fallback": ""
        }
      }
    },
    {
      "id": "footer",
      "type": "text",
      "placement": {
        "row": 12,
        "column": 1,
        "rowSpan": 1,
        "columnSpan": 12
      },
      "bindings": {
        "health": {
          "source": "game.state",
          "path": ["player", "health"],
          "fallback": "40"
        },
        "turn": {
          "source": "game.progression",
          "path": ["turn"]
        },
        "worldTimeMs": {
          "source": "game.progression",
          "path": ["worldTimeMs"]
        }
      },
      "presentation": {
        "align": "end"
      },
      "textKey": "scenes.inventory.components.footer.text"
    },
    {
      "id": "action-bar",
      "type": "action-bar",
      "placement": {
        "row": 9,
        "column": 5,
        "rowSpan": 3,
        "columnSpan": 8
      },
      "slots": {
        "4": {
          "labelKey": "actions.inspect",
          "action": {
            "type": "inventory-action",
            "inventory": "items",
            "action": "inspect"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-4"
          }
        },
        "5": {
          "labelKey": "actions.read",
          "action": {
            "type": "inventory-action",
            "inventory": "items",
            "action": "read"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-5"
          }
        },
        "1": {
          "labelKey": "equipment.equip",
          "action": {
            "type": "equipment-action",
            "equipment": "equipment",
            "operation": "equip"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-1"
          }
        },
        "2": {
          "labelKey": "equipment.unequip",
          "action": {
            "type": "equipment-action",
            "equipment": "equipment",
            "operation": "unequip"
          },
          "inputBinding": {
            "context": "gameplay",
            "input": "slot-2"
          }
        }
      }
    },
    {
      "id": "equipment",
      "type": "equipment",
      "inventory": "items",
      "owner": "player",
      "labelKey": "equipment.heading",
      "showCombatStats": true,
      "placement": {
        "row": 5,
        "column": 5,
        "rowSpan": 4,
        "columnSpan": 8
      }
    }
  ],
  "titleKey": "scenes.inventory.title",
  "descriptionKey": "scenes.inventory.description"
}
