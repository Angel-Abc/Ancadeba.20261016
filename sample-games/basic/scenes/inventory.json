{
  "schema-version": "1.0.0",
  "id": "inventory",
  "type": "game",
  "screen": {
    "type": "grid",
    "grid": {
      "rows": 12,
      "columns": 12
    }
  },
  "components": [
    {
      "id": "title",
      "type": "text",
      "placement": {
        "row": 1,
        "column": 1,
        "rowSpan": 2,
        "columnSpan": 12
      },
      "presentation": {
        "variant": "heading",
        "align": "center"
      },
      "textKey": "scenes.inventory.components.title.text"
    },
    {
      "id": "items",
      "type": "inventory",
      "placement": {
        "row": 3,
        "column": 1,
        "rowSpan": 8,
        "columnSpan": 4
      },
      "owners": ["player"],
      "readOnly": true,
      "labelKey": "scenes.inventory.title"
    },
    {
      "id": "details",
      "type": "text",
      "placement": {
        "row": 3,
        "column": 5,
        "rowSpan": 8,
        "columnSpan": 8
      },
      "textKey": "scenes.inventory.components.details.text"
    },
    {
      "id": "footer",
      "type": "text",
      "placement": {
        "row": 11,
        "column": 1,
        "rowSpan": 2,
        "columnSpan": 12
      },
      "bindings": {
        "health": {
          "source": "game.state",
          "path": ["player", "health"],
          "fallback": "40"
        },
        "turn": {
          "source": "game.progression",
          "path": ["turn"]
        },
        "worldTimeMs": {
          "source": "game.progression",
          "path": ["worldTimeMs"]
        }
      },
      "presentation": {
        "align": "end"
      },
      "textKey": "scenes.inventory.components.footer.text"
    }
  ],
  "titleKey": "scenes.inventory.title",
  "descriptionKey": "scenes.inventory.description"
}
