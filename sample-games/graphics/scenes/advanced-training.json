{
  "schema-version": "1.0.0",
  "id": "advanced-training",
  "type": "game",
  "title": "Advanced training",
  "screen": {
    "type": "grid",
    "grid": {
      "rows": 12,
      "columns": 12
    }
  },
  "components": [
    {
      "id": "combat",
      "type": "combat",
      "encounter": "advanced-training",
      "textTarget": "narrative",
      "placement": {
        "row": 1,
        "column": 1,
        "rowSpan": 7,
        "columnSpan": 9
      },
      "lootInventory": "loot"
    },
    {
      "id": "narrative",
      "type": "text",
      "text": "Choose a target, queue moves, then End Turn. Enemy intentions show their full plan. Leave to pause; return to resume. New Game resets the encounter.",
      "placement": {
        "row": 8,
        "column": 1,
        "rowSpan": 2,
        "columnSpan": 7
      }
    },
    {
      "id": "pause",
      "type": "button",
      "label": "Pause and return",
      "action": {
        "type": "enter-scene",
        "scene": "wardrobe"
      },
      "placement": {
        "row": 8,
        "column": 8,
        "rowSpan": 2,
        "columnSpan": 2
      }
    },
    {
      "id": "commands",
      "type": "action-bar",
      "placement": {
        "row": 10,
        "column": 1,
        "rowSpan": 3,
        "columnSpan": 12
      },
      "slots": {
        "1": {
          "label": "Attack",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "queue-move",
              "move": "attack"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "equip"
          }
        },
        "2": {
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "queue-move",
              "move": "poison-strike"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "unequip"
          },
          "label": "Poison Strike"
        },
        "3": {
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "queue-move",
              "move": "stunning-blow"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "buy"
          },
          "label": "Stunning Blow"
        },
        "4": {
          "label": "Undo",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "undo"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "sell"
          }
        },
        "5": {
          "label": "Clear plan",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "clear"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "slot-5"
          }
        },
        "6": {
          "label": "Next target",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "next-target"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "slot-6"
          }
        },
        "7": {
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "queue-move",
              "move": "weaken"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "slot-7"
          },
          "label": "Weaken"
        },
        "8": {
          "label": "Escape",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "escape"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "slot-8"
          }
        },
        "14": {
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "queue-move",
              "move": "battle-focus"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "slot-14"
          },
          "label": "Battle Focus"
        },
        "15": {
          "label": "End Turn",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "end-turn"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "slot-15"
          }
        },
        "9": {
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "queue-move",
              "move": "regenerate"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "slot-9"
          },
          "label": "Regenerate"
        },
        "10": {
          "label": "Take All",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "take-all-loot"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "slot-10"
          }
        },
        "11": {
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "queue-move",
              "move": "recover"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "slot-11"
          },
          "label": "Recover"
        },
        "12": {
          "label": "Power strike",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "queue-move",
              "move": "power-strike"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "slot-12"
          }
        },
        "13": {
          "label": "Return to training",
          "action": {
            "type": "enter-scene",
            "scene": "training"
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "slot-13"
          }
        }
      }
    },
    {
      "id": "loot",
      "type": "inventory",
      "label": "Victory loot",
      "owners": ["advanced-loot"],
      "readOnly": true,
      "descriptionTarget": "narrative",
      "placement": {
        "row": 1,
        "column": 10,
        "rowSpan": 4,
        "columnSpan": 3
      }
    },
    {
      "id": "loot-details",
      "type": "item-details",
      "inventory": "loot",
      "label": "Loot details",
      "placement": {
        "row": 7,
        "column": 10,
        "rowSpan": 3,
        "columnSpan": 3
      }
    },
    {
      "id": "progression",
      "type": "character-progression",
      "profile": "player",
      "placement": {
        "row": 5,
        "column": 10,
        "rowSpan": 2,
        "columnSpan": 3
      }
    }
  ]
}
