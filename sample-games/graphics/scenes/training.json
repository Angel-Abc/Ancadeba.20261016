{
  "schema-version": "1.0.0",
  "id": "training",
  "type": "game",
  "title": "Training courtyard",
  "screen": {
    "type": "grid",
    "grid": {
      "rows": 12,
      "columns": 12
    }
  },
  "components": [
    {
      "id": "combat",
      "type": "combat",
      "encounter": "training",
      "textTarget": "narrative",
      "placement": {
        "row": 1,
        "column": 1,
        "rowSpan": 7,
        "columnSpan": 12
      }
    },
    {
      "id": "narrative",
      "type": "text",
      "text": "Choose a target, queue moves, then End Turn. Enemy intentions show their full plan. Leave to pause; return to resume. New Game resets the encounter.",
      "placement": {
        "row": 8,
        "column": 1,
        "rowSpan": 2,
        "columnSpan": 10
      }
    },
    {
      "id": "pause",
      "type": "button",
      "label": "Pause and return",
      "action": {
        "type": "enter-scene",
        "scene": "wardrobe"
      },
      "placement": {
        "row": 8,
        "column": 11,
        "rowSpan": 2,
        "columnSpan": 2
      }
    },
    {
      "id": "commands",
      "type": "action-bar",
      "placement": {
        "row": 10,
        "column": 1,
        "rowSpan": 3,
        "columnSpan": 12
      },
      "slots": {
        "1": {
          "label": "Attack",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "queue-move",
              "move": "attack"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "equip"
          }
        },
        "2": {
          "label": "Heavy strike",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "queue-move",
              "move": "heavy"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "unequip"
          }
        },
        "3": {
          "label": "Guard",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "queue-move",
              "move": "guard"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "buy"
          }
        },
        "4": {
          "label": "Undo",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "undo"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "sell"
          }
        },
        "5": {
          "label": "Clear plan",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "clear"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "slot-5"
          }
        },
        "6": {
          "label": "Next target",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "next-target"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "slot-6"
          }
        },
        "7": {
          "label": "Previous target",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "previous-target"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "slot-7"
          }
        },
        "8": {
          "label": "Escape",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "escape"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "slot-8"
          }
        },
        "14": {
          "label": "Continue",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "continue"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "slot-14"
          }
        },
        "15": {
          "label": "End Turn",
          "action": {
            "type": "combat-action",
            "combat": "combat",
            "command": {
              "type": "end-turn"
            }
          },
          "inputBinding": {
            "context": "wardrobe",
            "input": "slot-15"
          }
        }
      }
    }
  ]
}
