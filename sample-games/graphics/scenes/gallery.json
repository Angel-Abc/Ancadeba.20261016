{
  "schema-version": "1.0.0",
  "id": "gallery",
  "title": "The asset wardrobe",
  "type": "stand-alone",
  "screen": {
    "type": "grid",
    "grid": {
      "rows": 12,
      "columns": 12
    }
  },
  "components": [
    {
      "id": "heading",
      "type": "text",
      "text": "One wardrobe. Many appearances.",
      "presentation": {
        "variant": "heading"
      },
      "placement": {
        "row": 1,
        "column": 1,
        "columnSpan": 12
      }
    },
    {
      "id": "adventurer-one",
      "type": "graphic",
      "visual": "paper-doll",
      "placement": {
        "row": 2,
        "column": 1,
        "rowSpan": 8,
        "columnSpan": 5
      },
      "alt": "Adventurer with a tunic, sword, and two-piece cloak",
      "appearance": {
        "slots": {
          "tunic": {
            "palette": "wayfarer"
          },
          "sword": {
            "palette": "steel"
          },
          "cloak": {
            "palette": "royal"
          }
        }
      }
    },
    {
      "id": "adventurer-two",
      "type": "graphic",
      "visual": "paper-doll",
      "placement": {
        "row": 2,
        "column": 6,
        "rowSpan": 8,
        "columnSpan": 5
      },
      "alt": "A second adventurer wearing a ranger tunic and carrying a curved saber",
      "appearance": {
        "slots": {
          "tunic": {
            "palette": "royal",
            "part": "ranger-tunic-part"
          },
          "sword": {
            "palette": "obsidian",
            "part": "saber-part"
          },
          "cloak": {
            "part": null
          }
        }
      }
    },
    {
      "id": "tunic-icon",
      "type": "graphic",
      "visual": "tunic",
      "placement": {
        "row": 3,
        "column": 11,
        "rowSpan": 3,
        "columnSpan": 2
      },
      "alt": "Matching tunic item preview",
      "appearance": {
        "palette": "wayfarer"
      }
    },
    {
      "id": "sword-icon",
      "type": "graphic",
      "visual": "sword",
      "placement": {
        "row": 6,
        "column": 11,
        "rowSpan": 3,
        "columnSpan": 2
      },
      "alt": "Matching sword item preview",
      "appearance": {
        "palette": "steel"
      }
    },
    {
      "id": "caption",
      "type": "text",
      "text": "Swap a wayfarer tunic for a ranger tunic, or a straight sword for a curved saber. Shared color slots keep each look customizable.",
      "placement": {
        "row": 10,
        "column": 1,
        "rowSpan": 2,
        "columnSpan": 12
      }
    },
    {
      "id": "another-look",
      "type": "button",
      "label": "Ember and bronze",
      "action": {
        "type": "enter-scene",
        "scene": "ember"
      },
      "placement": {
        "row": 12,
        "column": 1,
        "columnSpan": 12
      }
    }
  ]
}
