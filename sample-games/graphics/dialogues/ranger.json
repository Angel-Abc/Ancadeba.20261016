              "status": "not-started"
            }
          ]
        },
        {
          "id": "deliver",
          "label": "Here is your letter.",
          "end": true,
          "effects": [
            {
              "type": "complete-quest",
              "quest": "ranger-letter"
            }
          ],
          "visibleWhen": [
            {
              "type": "quest-state",
              "quest": "ranger-letter",
              "status": "ready"
