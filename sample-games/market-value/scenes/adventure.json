{
  "schema-version": "1.0.0",
  "id": "adventure",
  "title": "Adventure",
  "description": "",
  "type": "game",
  "screen": {
    "type": "grid",
    "grid": {
      "rows": 32,
      "columns": 32
    }
  },
  "components": [
    {
      "id": "narrative",
      "type": "text",
      "placement": {
        "row": 1,
        "column": 8,
        "rowSpan": 22,
        "columnSpan": 18
      },
      "text": "You wake on a beach with wet sand against your cheek. A blinding headache makes you squeeze your eyes shut. You try to remember how you got here, then try to remember your own name. Nothing comes. A few scraps of fabric cling to your skin. They’re all you have.",
      "presentation": {
        "variant": "body",
        "align": "start"
      }
    },
    {
      "id": "edit-appearance",
      "type": "button",
      "label": "Edit appearance",
      "placement": {
        "row": 17,
        "column": 1,
        "rowSpan": 3,
        "columnSpan": 7
      },
      "action": {
        "type": "enter-scene",
        "scene": "appearance"
      }
    },
    {
      "id": "menu",
      "type": "button",
      "placement": {
        "row": 13,
        "column": 1,
        "rowSpan": 3,
        "columnSpan": 7
      },
      "label": "Game menu (Escape)",
      "action": {
        "type": "open-menu",
        "scene": "game-menu"
      }
    },
    {
      "id": "coast-map",
      "type": "map-view",
      "placement": {
        "row": 23,
        "column": 1,
        "rowSpan": 10,
        "columnSpan": 7
      },
      "map": "coast",
      "label": "Coast",
      "viewport": {
        "columns": 10,
        "rows": 8,
        "x": 0,
        "y": 0
      },
      "playerSpawn": {
        "x": 8,
        "y": 9
      },
      "interactive": true
    },
    {
      "id": "player-inventory",
      "type": "inventory",
      "placement": {
        "row": 1,
        "column": 26,
        "rowSpan": 12,
        "columnSpan": 7
      },
      "label": "Inventory",
      "owners": ["player"],
      "characterPreviews": {},
      "readOnly": true
    },
    {
      "id": "pickup-help",
      "type": "text",
      "placement": {
        "row": 1,
        "column": 1,
        "rowSpan": 12,
        "columnSpan": 7
      },
      "text": "Use arrow keys to move. Pick up the driftwood and rope on the beach, then use Crafting to make a fishing rod.",
      "presentation": {
        "variant": "body",
        "align": "start"
      }
    },
    {
      "id": "beach-crafting",
      "type": "crafting",
      "placement": {
        "row": 13,
        "column": 26,
        "rowSpan": 20,
        "columnSpan": 7
      },
      "label": "Crafting",
      "owner": "player"
    },
    {
      "id": "action-bar",
      "type": "action-bar",
      "placement": {
        "row": 23,
        "column": 8,
        "rowSpan": 10,
        "columnSpan": 18
      },
      "slots": {
        "1": {
          "label": "Pick up driftwood",
          "showOnlyWhenActive": true,
          "action": {
            "type": "interact-map",
            "mapView": "coast-map",
            "object": "driftwood"
          }
        },
        "2": {
          "label": "Pick up rope",
          "showOnlyWhenActive": true,
          "action": {
            "type": "interact-map",
            "mapView": "coast-map",
            "object": "rope"
          }
        }
      }
    }
  ]
}
