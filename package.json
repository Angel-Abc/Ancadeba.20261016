{
  "name": "ancadeba",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:packages && vp run --filter \"./apps/*\" --filter \"./packages/*\" --parallel dev",
    "build:packages": "vp run --filter \"./packages/*\" build",
    "build": "vp run --filter \"./apps/*\" --filter \"./packages/*\" build",
    "export:game": "pnpm build:packages && pnpm --filter @ancadeba/engine typecheck && tsx tooling/export-game.ts",
    "check": "pnpm build:packages && vp check && pnpm typecheck:all",
    "lint": "pnpm build:packages && vp lint && vp fmt --check",
    "lint:fix": "vp lint --fix && vp fmt",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "pnpm build:packages && pnpm typecheck:all",
    "typecheck:all": "vp run --filter \"./apps/*\" --filter \"./packages/*\" typecheck && tsc --noEmit -p tsconfig.json",
    "test": "pnpm build:packages && vp test",
    "test:watch": "pnpm build:packages && vp test watch"
  },
  "devDependencies": {
    "@ancadeba/game-runtime": "workspace:*",
    "@ancadeba/schemas": "workspace:*",
    "@ancadeba/ui-components": "workspace:*",
    "@ancadeba/utilities": "workspace:*",
    "@types/node": "^24.19.2",
    "fflate": "^0.8.3",
    "tsx": "4.23.15",
    "typescript": "~7.0.2",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0",
    "pnpm": ">=11.5.1"
  },
  "packageManager": "pnpm@11.5.1"
}
